# Caddy 反向代理 - 拷贝到服务器 /etc/caddy/Caddyfile
# TLS 用 Cloudflare Origin CA 证书(15 年有效),配合 CF SSL 模式 Full (strict)
# 证书放 /etc/caddy/ssl/origin.pem 和 origin.key,权限 0600 root

tunan.fun {
	tls /etc/caddy/ssl/origin.pem /etc/caddy/ssl/origin.key

	# Next standalone 14.1.4 服务不了路径带 [动态段] 的静态 chunk(%5B 解码后被路由拦截,404),
	# 由 Caddy 直接读盘:URL /_next/static/... 映射到磁盘 /opt/tunan-ui/.next/static/...
	handle /_next/static/* {
		uri strip_prefix /_next
		root * /opt/tunan-ui/.next
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# RSS:后端按 apikey 鉴权,这里注入后转译(Caddyfile 里的 {$RSS_APIKEY}
	# 来自 caddy 服务的 systemd 环境变量,由 server-root-setup.sh 从 prod.yaml 提取)
	handle /rss.xml {
		rewrite * /api/rss?apikey={$RSS_APIKEY}
		reverse_proxy 127.0.0.1:3002
	}

	# API → Go 后端
	handle /api/* {
		reverse_proxy 127.0.0.1:3002
	}

	# 管理后台(ui-admin 已带 basePath /admin,无需去前缀)
	handle /admin* {
		reverse_proxy 127.0.0.1:3001
	}

	# 其余全给主站;X-Forwarded-Host 供 Next 中间件还原真实域名(重定向用)
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-Host {host}
		}
	}
}

www.tunan.fun {
	tls /etc/caddy/ssl/origin.pem /etc/caddy/ssl/origin.key
	redir https://tunan.fun{uri} permanent
}

remark42.tunan.fun {
	tls /etc/caddy/ssl/origin.pem /etc/caddy/ssl/origin.key
	reverse_proxy 127.0.0.1:8080
}
